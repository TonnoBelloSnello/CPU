# Ignore extensionless files (build binaries), keep directories and anything
# with an extension.  Rules below then carve out the generated artefacts.
*
!*/
!*.*

*.*.bak
.vscode/
__pycache__/
**/*.vcd
*.bin
*.pyc
.DS_Store

# ── Quartus build directory ──────────────────────────────────────────
# Only the project definition is tracked here.  CPUFrFr.qsf references the
# canonical RTL and MIF files outside this build directory.
quartus/db/
quartus/incremental_db/
quartus/output_files/
quartus/simulation/
quartus/.qsys_edit/
quartus/greybox_tmp/
**/c5_pin_model_dump.txt

# Compile reports and status files
quartus/*.rpt
quartus/*.summary
quartus/*.qmsg
quartus/*.smsg
quartus/*.done
quartus/*.jdi
quartus/*.pin
quartus/*.sld
quartus/*.cdf
quartus/*.qws
quartus/*_description.txt
quartus/*_nativelink_simulation.rpt

# Prevent obsolete source/generated copies from being reintroduced.  Quartus
# reads these directly from hdl/ and the repository root.
quartus/*.sv
quartus/*.svh
quartus/*.v
quartus/*.sdc
quartus/*.mif

# Bitstreams: regenerated by a compile, 6.4 MB each
*.sof
*.pof
*.rbf
*.jic

# ── Encoder output ───────────────────────────────────────────────────
# Regenerated by scripts/encode.ps1.  This rule used to say "encoder/out/**",
# which never matched the real path.
src/cpu/encoder/out/**
!src/cpu/encoder/out/.gitkeep

# ── VSCode extension build output ────────────────────────────────────
tools/vscode-de1/node_modules/
tools/vscode-de1/dist/
tools/vscode-de1/*.vsix

src/cpu/web/node_modules/
