 46, 80, 58}}  # 5 pitch levels, 8 yaw levels

main:
    MOV R1, V0
    SAVE R1, [yaw_idx]
    MOV R1, V2
    SAVE R1, [pitch_idx]
    LSL R1, V3
    SAVE R1, [last_frame_idx]
    MOV HEX, R1
    MOV LE, V0
    MOV R2, R1
    MOV R12, V255
    BL draw_frame

main_loop:
    WAITKNB R0, V15
    MOV LE, R0

    MOV R1, [yaw_idx]
    TST R0, V1
    BEQ no_yaw_left
    CMP R1, V0
    MOVEQ R1, V7
    SUBNE R1, R1, V1
no_yaw_left:
    TST R0, V2
    BEQ no_yaw_right
    ADD R1, R1, V1
    CMP R1, V8
    MOVEQ R1, V0
no_yaw_right:
    SAVE R1, [yaw_idx]

    MOV R2, [pitch_idx]
    TST R0, V4
    BEQ no_pitch_up
    CMP R2, V0
    SUBGT R2, R2, V1
no_pitch_up:
    TST R0, V8
    BEQ no_pitch_down
    CMP R2, V4
    ADDLT R2, R2, V1
no_pitch_down:
    SAVE R2, [pitch_idx]

    MOV R3, R2
    LSL R3, V3
    ADD R3, R3, R1
    MOV HEX, R3

    MOV R4, [last_frame_idx]
    CMP R3, R4
    BEQ frame_wait

    SAVE R3, [last_frame_idx]

    MOV R2, R4
    MOV R12, V0
    BL draw_frame

    MOV R2, [last_frame_idx]
    MOV R12, V255
    BL draw_frame

frame_wait:
    WAIT V20
    B main_loop

draw_frame:
    MOV R11, R14
    SAVEM R11, [ret_draw_frame]
    MOV R8, frames
    MOV R9, R2
    MUL R9, R9, V48
    ADD R8, R8, R9
    MOV R9, V12

draw_frame_loop:
    MOV R0, [R8]
    ADD R8, R8, V1
    MOV R1, [R8]
    ADD R8, R8, V1
    MOV R2, [R8]
    ADD R8, R8, V1
    MOV R3, [R8]
    ADD R8, R8, V1

    SAVEM R8, [frame_ptr]
    SAVE R9, [seg_count]
    BL draw_line
    MOVM R8, [frame_ptr]
    MOV R9, [seg_count]

    SUB R9, R9, V1
    CMP R9, V0
    BNE draw_frame_loop

    MOVM R11, [ret_draw_frame]
    MOV PC, R11

draw_line:
    SUB R4, R2, R0
    ABS R4, R4

    MOV R6, V1
    CMP R0, R2
    MVNGT R6, V0

    SUB R5, R3, R1
    ABS R5, R5

    MOV R7, V1
    CMP R1, R3
    MVNGT R7, V0

    CMP R4, R5
    BGE draw_line_x_major

draw_line_y_major:
    MOV R8, V0

draw_line_y_loop:
    PIXELNB R0, R1, R12

    CMP R1, R3
    BEQ draw_line_done

    ADD R1, R1, R7
    ADD R8, R8, R4
    CMP R8, R5
    BLT draw_line_y_no_x
    ADD R0, R0, R6
    SUB R8, R8, R5

draw_line_y_no_x:
    B draw_line_y_loop

draw_line_x_major:
    MOV R8, V0

draw_line_x_loop:
    PIXELNB R0, R1, R12

    CMP R0, R2
    BEQ draw_line_done

    ADD R0, R0, R6
    ADD R8, R8, R5
    CMP R8, R4
    BLT draw_line_x_no_y
    ADD R1, R1, R7
    SUB R8, R8, R4

draw_line_x_no_y:
    B draw_line_x_loop

draw_line_done:
    MOV PC, R14
