gen_gun:
    MOV R10, =GUN_BASE
    MOV R0, V0
gun_gen_x:
    MOV R1, V0
gun_gen_y:
    MOV R2, V0
    SUB R4, R0, V16
    ABS R4, R4

    CMP R1, V25
    BLT gun_gen_body
    SUB R5, R0, V9
    ABS R5, R5
    SUB R6, R0, V23
    ABS R6, R6
    MIN R5, R5, R6
    CMP R5, V6
    BGT gun_gen_body
    MOV R2, V104
    CMP R5, V6
    MOVEQ R2, V68
    SUB R7, R1, V25
    AND R7, R7, V7
    CMP R7, V0
    MOVEQ R2, V68
    CMP R7, V5
    MOVEQ R2, V141

gun_gen_body:
    CMP R1, V13
    BLT gun_gen_barrel
    CMP R1, V30
    BGT gun_gen_barrel
    SUB R6, R1, V13
    ADD R6, R6, V7
    MIN R6, R6, V12
    CMP R4, R6
    BGT gun_gen_barrel
    MOV R2, V146
    SUB R7, R6, V1
    CMP R4, R7
    MOVGE R2, V73
    CMP R4, V3
    MOVLE R2, V182

gun_gen_barrel:
    CMP R1, V17
    BGT gun_gen_store
    CMP R4, V5
    BGT gun_gen_store
    MOV R2, V73
    CMP R4, V4
    MOVLE R2, V146
    CMP R4, V1
    MOVLE R2, V182
    CMP R1, V1
    MOVLE R2, V182
    CMP R1, V2
    BGT gun_gen_store
    CMP R4, V3
    MOVLE R2, V36

gun_gen_store:
    MUL R5, R0, GUN_H
    ADD R5, R5, R1
    ADD R5, R5, R10
    SAVE R2, [R5]
    ADD R1, R1, V1
    CMP R1, GUN_H
    BLT gun_gen_y
    ADD R0, R0, V1
    CMP R0, GUN_W
    BLT gun_gen_x
    MOV PC, R14

gen_sky:
    MOV R7, =SKY_BASE
    MOV R0, V0
sky_loop:
    CMP R0, HORIZON
    BGE sky_floor
    LSR R1, R0, V4
    LSL R4, R1, V2
    ADD R4, R4, V1
    CMP R1, V2
    ADDGE R4, R4, V1
    B sky_store
sky_floor:
    SUB R1, R0, HORIZON
    LSR R1, R1, V4
    ADD R2, R1, V2
    LSL R4, R2, V5
    ADD R4, R4, R2 LSL V2
    LSR R3, R2, V1
    ADD R4, R4, R3
sky_store:
    ADD R5, R7, R0
    SAVE R4, [R5]
    ADD R0, R0, V1
    CMP R0, VIEW_H
    BLT sky_loop
    MOV PC, R14

gen_map:
    MOV R10, =LCG_MUL
    MOV R12, =LCG_ADD
    MOVM R8, [seed]

    MOV R7, =MAP_BASE
    MOV R0, V0
    MOV R2, V1
map_fill:
    ADD R6, R7, R0
    SAVE R2, [R6]
    ADD R0, R0, V1
    CMP R0, V1024
    BLT map_fill

    MOV R1, V1
maze_y:
    MOV R0, V1
maze_x:
    MUL R8, R8, R10
    ADD R8, R8, R12
    LSL R6, R1, V5
    ADD R6, R6, R0
    ADD R6, R6, R7
    MOV R2, V0
    SAVE R2, [R6]

    MOV R3, V0
    CMP R1, V1
    MOVGT R3, V1
    MOV R4, V0
    CMP R0, V29
    MOVLT R4, V1
    LSR R5, R8, V9
    AND R5, R5, V1

    CMP R3, V0
    BEQ maze_try_east
    CMP R4, V0
    BEQ maze_do_north
    CMP R5, V0
    BEQ maze_do_north
    B maze_do_east
maze_do_north:
    SUB R9, R1, V1
    LSL R6, R9, V5
    ADD R6, R6, R0
    ADD R6, R6, R7
    MOV R2, V0
    SAVE R2, [R6]
    B maze_next
maze_try_east:
    CMP R4, V0
    BEQ maze_next
maze_do_east:
    LSL R6, R1, V5
    ADD R6, R6, R0
    ADD R6, R6, V1
    ADD R6, R6, R7
    MOV R2, V0
    SAVE R2, [R6]
maze_next:
    ADD R0, R0, V2
    CMP R0, V30
    BLT maze_x
    ADD R1, R1, V2
    CMP R1, V30
    BLT maze_y

    MOV R5, V0
room_loop:
    MUL R8, R8, R10
    ADD R8, R8, R12
    LSR R0, R8, V8
    AND R0, R0, V15
    ADD R0, R0, V4
    MUL R8, R8, R10
    ADD R8, R8, R12
    LSR R1, R8, V8
    AND R1, R1, V15
    ADD R1, R1, V4
    MOV R2, V0
room_y:
    MOV R3, V0
room_x:
    ADD R9, R1, R2
    LSL R6, R9, V5
    ADD R9, R0, R3
    ADD R6, R6, R9
    ADD R6, R6, R7
    MOV R4, V0
    SAVE R4, [R6]
    ADD R3, R3, V1
    CMP R3, V5
    BLT room_x
    ADD R2, R2, V1
    CMP R2, V5
    BLT room_y
    ADD R5, R5, V1
    CMP R5, V10
    BLT room_loop

    SAVEM R8, [seed]

    MOV R1, V0
assign_y:
    MOV R0, V0
assign_x:
    LSL R6, R1, V5
    ADD R6, R6, R0
    ADD R6, R6, R7
    MOV R2, [R6]
    MOV R3, V0
    CMP R0, V0
    MOVEQ R3, V1
    CMP R0, V31
    MOVEQ R3, V1
    CMP R1, V0
    MOVEQ R3, V1
    CMP R1, V31
    MOVEQ R3, V1
    CMP R3, V1
    MOVEQ R2, V1
    CMP R2, V0
    BEQ assign_next
    LSR R4, R0, V3
    LSR R5, R1, V3
    ADD R4, R4, R5
    AND R4, R4, V3
    ADD R4, R4, V1
    SAVE R4, [R6]
assign_next:
    ADD R0, R0, V1
    CMP R0, V32
    BLT assign_x
    ADD R1, R1, V1
    CMP R1, V32
    BLT assign_y

    MOV R1, V1
spawn_pocket_y:
    MOV R0, V1
spawn_pocket_x:
