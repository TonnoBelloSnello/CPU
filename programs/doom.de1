    CMP R1, V12
    BLT ammo_store
    CMP R1, V15
    BGT ammo_body
    CMP R5, V5
    BGT ammo_store
    AND R6, R0, V1
    CMP R6, V0
    BNE ammo_store
    MOV R2, V252
    CMP R1, V12
    MOVEQ R2, V240
    B ammo_store
ammo_body:
    CMP R1, V27
    BGT ammo_store
    CMP R5, V6
    BGT ammo_store
    MOV R2, V76
    CMP R5, V6
    MOVEQ R2, V36
    CMP R1, V27
    MOVEQ R2, V36
    CMP R1, V16
    MOVEQ R2, V36
    ADD R6, R1, V3
    AND R6, R6, V7
    CMP R6, V0
