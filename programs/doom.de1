    MOV R2, V255
    CMP R5, V7
    MOVEQ R2, V146
    CMP R1, V12
    MOVEQ R2, V146
    CMP R1, V27
    MOVEQ R2, V146
    CMP R2, V146
    BEQ med_store
    CMP R5, V1
    BGT med_bar
    CMP R1, V16
    BLT med_store
    CMP R1, V23
